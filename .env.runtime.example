# Copy to .env.runtime or use scripts/start-demo.ps1
RUNTIME_DIR=./runtime/current

# Sender capture policy
SENDER_CAPTURE_FILTER=tcp and dst port 80

# Sender -> receiver mapping and payload image selection
SENDER_1_TARGET_URL=http://node-9:80/upload
SENDER_2_TARGET_URL=http://node-10:80/upload
SENDER_3_TARGET_URL=http://node-11:80/upload
SENDER_4_TARGET_URL=http://node-12:80/upload
SENDER_5_TARGET_URL=http://node-13:80/upload
SENDER_6_TARGET_URL=http://node-14:80/upload
SENDER_7_TARGET_URL=http://node-15:80/upload
SENDER_8_TARGET_URL=http://node-16:80/upload

# Default profile: 5 clean + 3 stego (nodes 5,6,7)
SENDER_1_IMAGE_FILE=/test_images/cover_test00001.jpg
SENDER_2_IMAGE_FILE=/test_images/cover_test00002.jpg
SENDER_3_IMAGE_FILE=/test_images/cover_test00001.jpg
SENDER_4_IMAGE_FILE=/test_images/cover_test00002.jpg
SENDER_5_IMAGE_FILE=/test_images/stego1_test00001.jpg
SENDER_6_IMAGE_FILE=/test_images/stego1_test00001.jpg
SENDER_7_IMAGE_FILE=/test_images/stego2_test00002.jpg
SENDER_8_IMAGE_FILE=/test_images/cover_test00001.jpg
